#!/bin/sh
# Run a command in a borderless kitty panel inset 15% from each screen edge.
# Usage: kp <command> [args...]

read -r w h <<EOF
$(system_profiler SPDisplaysDataType | grep Resolution | awk '{print $2, $4}')
EOF
# Divide in half because system_profiler returns Retina resolution
x=$((w / 2 * 25 / 100))
y=$((h / 2 * 25 / 100))
kitten="/Applications/kitty.app/Contents/MacOS/kitten"

in=$(mktemp)
out=$(mktemp)

cat </dev/stdin >$in

${kitten} \
    panel \
    --focus-policy=exclusive \
    --hide-on-focus-loss \
    --margin-left="$x" \
    --margin-right="$x" \
    --margin-top="$y" \
    --margin-bottom="$y" \
    --edge=center \
    --layer=overlay \
    --override background=#2f2f2f \
    --override tab_bar_min_tabs=2 \
    sh -c 'out=$1; in=$2; shift; shift; $@ <"$in" >"$out"' _ "$out" "$in" "$@"
cat "$out"
rm -f "$in"
rm -f "$out"
